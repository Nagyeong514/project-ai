# 환경 변수
.env
*.env

# 가상환경 · 로컬 벡터DB — 폴더명 무관 일반 패턴(2026-07 폴더 재구성으로 아래 개별 경로가
# 옛 이름이라 안 맞는 문제 방지. venv/DB는 대용량이라 절대 커밋 금지).
.venv/
chroma_db/
qdrant_db/

# Python 캐시
__pycache__/
*.pyc
*.pyo

# 영상 파일 (용량 크고 민감)
*.mp4

# 파이프라인 산출물 JSON
output/*
!output/.gitkeep

# AI 모델 바이너리 (용량 큰 파일 - 별도 다운로드 필요)
models/*
!models/.gitkeep

# PDF 원문 및 임시 추출 텍스트
*.pdf
pdf_*.txt
audio_check.txt

# Node.js
web/node_modules/
node_modules/

# Whisper 모델 캐시
.cache/

# VS Code
.vscode/

# 기타 산출물 (이전 루트 위치 호환)
*_features.json
*_insights.json
*_highlights.json
*.pt
*.task

# VAD STT 연구 — 대용량 데이터 및 중간 산출물
02_VAD효과/data/raw/
02_VAD효과/results/raw/
02_VAD효과/batch_addon/run_batch.log
*.wav
*.webm
INNORIX-EX-Agent-Ubuntu_20.04.deb

# STT 비교 연구 — 대용량 데이터 및 중간 산출물
00_사전연구/01_STT선정/data/raw/
00_사전연구/01_STT선정/results/raw/
00_사전연구/01_STT선정/models/
00_사전연구/01_STT선정/.venv/

# VLM 암묵지 연구 ④ — 대용량 데이터 및 중간 산출물 (프레임 jpg 등)
05_VLM암묵지추출_MAIN/data/raw/
05_VLM암묵지추출_MAIN/results/

# 전처리 파이프라인(STEP3/4/5, 2026-07-04 분할) — 로컬 백업본 / 각 STEP의 산출물
STEP3_전처리_baseline_clean_0630/
STEP3_전처리/.venv/
# STEP3 transcripts: STT 결과 json은 산출물로 추적(대용량 원본 오디오만 별도 *.wav 규칙으로 제외).
# STEP3 output: 원본 영상/오디오/프레임 이미지(mp4·wav·jpg)는 용량·민감성 때문에 계속 무시하되,
# frames_meta.json(각 클립 프레임 추출 메타)만 결과물로 추적한다.
# 주의: 부모를 `/*`로 무시해야 하위 재포함(!)이 동작함(`dir/`로 무시하면 git이 안 들어가 봄).
STEP3_전처리/output/*
!STEP3_전처리/output/_frames/
STEP3_전처리/output/_frames/*
!STEP3_전처리/output/_frames/*/
STEP3_전처리/output/_frames/*/*
!STEP3_전처리/output/_frames/*/frames_meta.json
# STEP4 output(비-모션): detections·vlm_observations 전부 json이라 그대로 추적.
# 2026-07-13 모션O 병합 이후 산출물은 output_motion/ 쪽 규칙 참고.
# output_motion: vlm_observations_original_ts(재생성 불가한 유일 백업)에 더해
# detections·vlm_observations·*_by_group도 전부 json뿐이라 함께 추적한다.
STEP4_YOLO_VLM관찰/output_motion/*
!STEP4_YOLO_VLM관찰/output_motion/vlm_observations_original_ts/
!STEP4_YOLO_VLM관찰/output_motion/detections/
!STEP4_YOLO_VLM관찰/output_motion/detections_by_group/
!STEP4_YOLO_VLM관찰/output_motion/vlm_observations/
!STEP4_YOLO_VLM관찰/output_motion/vlm_observations_by_group/
STEP5_LLM으로_암묵지_후보생성/output/
파이프라인_통합실행/.venv/

# YOLO export(받은 산출물, 대용량 — best.pt는 *.pt로 이미 무시)
yolo_local_v13_0629-*/

# STEP6_품질검증 — venv(대용량)
STEP6_품질검증/.venv/

# STEP7_DB — venv 및 로컬 Vector DB 산출물(대용량)
STEP7_DB/.venv/
STEP7_DB/qdrant_db/

# STEP8_RAG서비스 — venv 및 로컬 Vector DB 산출물(대용량, --system-site-packages라 재현 불가하므로
# 다른 환경에서는 README대로 새로 만들 것)
STEP8_RAG서비스/.venv/
STEP8_RAG서비스/qdrant_db/
